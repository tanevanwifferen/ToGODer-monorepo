// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

// table for users, containing id, privateKeyHash, maxMessagesPerDay, messagesLeft, and chats
model User {
  id                String           @id @default(uuid())
  sharedChats       SharedChat[]
  sharedArtifacts   SharedArtifact[]
  sharedFolders     SharedFolder[]
  email             String        @unique
  password          String
  verified          Boolean       @default(false)
  verificationToken String        @default(uuid())
  tokenVersion      Int           @default(0)
  createdAt         DateTime      @default(now())
  dataSync          UserDataSync?
  mcpServers        McpServer[]
  referralCode      String?       @unique
  creditsBalance    Decimal       @default(0)
  referralsMade     Referral[]          @relation("ReferralReferrer")
  referralsReceived Referral[]          @relation("ReferralReferred")
  creditTransactions CreditTransaction[]
  pushTokens        PushToken[]
  scheduledWakeups  ScheduledWakeup[]
  serverMemories    ServerMemory[]
}

model UserDataSync {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  encryptedData String   // Base64 encrypted blob
  lastModified  DateTime @updatedAt
  version       Int      @default(1)
  createdAt     DateTime @default(now())
}

model Payment {
  id         String   @id @default(uuid())
  user_email String
  timestamp  DateTime @default(now())
  amount     Decimal
  message    String?
}

model Usage {
  id         String  @id @default(uuid())
  user_email String
  year       Int
  month      Int
  amount     Decimal
}

// table for chats, containing id, title, date, likes, messages, and userId
model Chat {
  id        String    @id @default(uuid())
  emailHash String
  title     String
  date      DateTime  @default(now())
  likes     Int
  messages  Message[]
}

// table for messages, containing id, chatId, timestamp, content, and userId
model Message {
  id        String   @id @default(uuid())
  chatId    String
  timestamp DateTime @default(now())
  content   String
  chat      Chat     @relation(fields: [chatId], references: [id])
}

// table for shared chats, containing id, title, description, messages with their signatures, owner reference, and visibility
model SharedChat {
  id                 String   @id @default(uuid())
  ownerId            String
  owner              User     @relation(fields: [ownerId], references: [id])
  title              String
  description        String?
  createdAt          DateTime @default(now())
  messages           String // JSON blob containing messages with their signatures
  views              Int      @default(0)
  visibility         String   @default("PUBLIC") // Can be "PUBLIC" or "PRIVATE"
  instructionHistory String? // JSON blob of signed {content, timestamp, signature} custom-instruction snapshots
  publishedToPayload Boolean  @default(false) // Set true when published to Payload (admin action)
}

// table for shared artifacts (project files shared as standalone documents)
model SharedArtifact {
  id                 String   @id @default(uuid())
  ownerId            String
  owner              User     @relation(fields: [ownerId], references: [id])
  title              String
  description        String?
  content            String
  createdAt          DateTime @default(now())
  views              Int      @default(0)
  visibility         String   @default("PUBLIC") // Can be "PUBLIC" or "PRIVATE"
  instructionHistory String? // JSON blob of signed {content, timestamp, signature} custom-instruction snapshots
  artifactSignature  String? // HMAC signature proving the artifact was AI-generated (not hand-written)
  publishedToPayload Boolean           @default(false) // Set true when published to Payload (admin action)
  sharedFolderItems   SharedFolderItem[]
}

// table for shared folders (collections of artifacts shared together)
model SharedFolder {
  id                 String            @id @default(uuid())
  ownerId            String
  owner              User              @relation(fields: [ownerId], references: [id])
  title              String
  description        String?
  createdAt          DateTime          @default(now())
  views              Int               @default(0)
  visibility         String            @default("PUBLIC")
  items              SharedFolderItem[]
  publishedToPayload Boolean           @default(false)
}

// individual item within a shared folder (references a SharedArtifact)
model SharedFolderItem {
  id          String        @id @default(uuid())
  folderId    String
  folder      SharedFolder  @relation(fields: [folderId], references: [id], onDelete: Cascade)
  artifactId  String
  artifact    SharedArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  sortOrder   Int           @default(0)

  @@index([folderId])
  @@index([artifactId])
}

// table for MCP servers (per-user, HTTP-based MCP server connections)
model McpServer {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  url         String
  headersJson String   @default("{}")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Event {
  id        String   @id @default(uuid())
  timestamp DateTime @default(now())
  userId    String?
  eventType String
  source    String?
  propsJson String?

  @@index([eventType])
  @@index([timestamp])
  @@index([userId])
}

model Referral {
  id              String   @id @default(uuid())
  createdAt       DateTime @default(now())
  referrerCode    String
  referrerUserId  String
  referrer        User     @relation("ReferralReferrer", fields: [referrerUserId], references: [id])
  referredUserId  String   @unique
  referred        User     @relation("ReferralReferred", fields: [referredUserId], references: [id])
  level           Int      @default(1) // 1 = direct, 2 = second-level
  credited        Boolean  @default(false) // whether commission was already credited

  @@index([referrerUserId])
  @@index([referrerCode])
}

model CreditTransaction {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  amount      Decimal
  type        String   // "credit" or "debit"
  source      String   // "referral", "deposit", "redemption", "admin"
  description String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// table for push notification tokens (Expo Push Token per user-device)
model PushToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   @default("ios") // "ios" | "android" | "web"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// table for scheduled assistant wake-ups (cron-triggered push notifications)
model ScheduledWakeup {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  triggerAt   DateTime  // when to fire the wake-up
  reason      String    // why the assistant scheduled this (set by the LLM)
  fired       Boolean   @default(false)
  firedAt     DateTime?
  cancelled   Boolean   @default(false)
  resultJson  String?   // JSON: { shouldPing, message, reasoning }
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([triggerAt])
  @@index([fired])
}

// Server-side mirror of client memory store so the WakeupService can read
// memories without the client being connected. Values are plaintext (not
// encrypted) — only the key/namespace matters for wake-up context.
model ServerMemory {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String   // memory key (e.g. "/short-term/mood")
  value     String   // memory value (plaintext)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([userId, key])
  @@index([userId])
  @@index([updatedAt])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL_RAW")
}
